<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ExileCenter.Migration</AssemblyName>
    <RootNamespace>ExileCenter.Migration</RootNamespace>
    <Product>ExileCenter</Product>
    <AssemblyTitle>ExileCenter Migration</AssemblyTitle>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ExileCenterReleaseTag Condition="'$(ExileCenterReleaseTag)' == ''">v1.5.11-personnalise.51</ExileCenterReleaseTag>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../ExileCenter/Utils/UpdatePathHelper.cs" Link="UpdatePathHelper.cs" />
    <AssemblyMetadata Include="ExileCenterReleaseTag" Value="$(ExileCenterReleaseTag)" />
  </ItemGroup>
</Project>
