<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ExileCenter\ExileCenter.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\jewel_mod_ranges.json;Data\tablet_mod_ranges.json" />
    <EmbeddedResource Include="Data\tablet_meta_rankings.json" />
    <None Update="Data\jewel_mod_ranges.json;Data\tablet_mod_ranges.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <Copy SourceFiles="@(StashLocalizationFiles)" DestinationFolder="..\..\ExileCenter\$(OutDir)Plugins\$(ProjectName)\Localization" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StashTabletIcons)" DestinationFolder="..\..\ExileCenter\$(OutDir)Plugins\$(ProjectName)\images" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)$(TargetName)$(TargetExt);$(OutDir)$(TargetName).pdb;" DestinationFolder="..\..\ExileCenter\$(OutDir)Plugins\$(ProjectName)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Data\jewel_mod_ranges.json;$(MSBuildProjectDirectory)\Data\tablet_mod_ranges.json" DestinationFolder="..\..\ExileCenter\$(OutDir)Plugins\$(ProjectName)\Data" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <StashLocalizationFiles Include="Localization\*.json" />
    <StashTabletIcons Include="images\Tablet*.webp" />
  </ItemGroup>

</Project>
