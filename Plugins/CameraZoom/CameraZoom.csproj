<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\GameHelper\GameHelper.csproj" Private="false" CopyLocalSatelliteAssemblies="false" />
    <CameraLocalization Include="Localization\*.json" />
  </ItemGroup>
  <Target Name="CopyFiles" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\CameraZoom" />
    <Copy SourceFiles="@(CameraLocalization)" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\CameraZoom\Localization" />
  </Target>
</Project>
